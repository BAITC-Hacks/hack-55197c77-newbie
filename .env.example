# Copy this file to .env. Never commit .env or paste a real key into chat.
# The key, model and API URL must belong to the same provider.
AI_API_KEY=
AI_MODEL=gpt-6-luna
AI_BASE_URL=https://api.openai.com/v1
# Use json_object only if your provider does not support json_schema.
AI_OUTPUT_FORMAT=json_schema
